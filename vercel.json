{
  "version": 2,
  "functions": {
    "api/checkout.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/checkout.php",
      "dest": "/api/checkout.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}